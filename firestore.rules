rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 教務手帳のデータは users/{uid}/techou/data の1ドキュメントに保存される。
    // 保存できるのは本人（request.auth.uid が uid と一致するログイン済みユーザー）だけとし、
    // フィールドも push() が書き込む json / updatedAt のみに限定する。
    match /users/{uid}/techou/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && docId == "data"
                   && request.resource.data.keys().hasOnly(["json", "updatedAt"])
                   && request.resource.data.json is map
                   && request.resource.data.updatedAt is number;
    }

    // QR提出チェックの記録は users/{uid}/submits/{sessionId} に置く。
    // 生徒の氏名は入れない（クラス名・出席番号・提出時刻だけ）。
    // スマホとPCの両方が marks を1件ずつ merge で書くため、
    // フィールド名だけを制限し、書き込み自体は本人に許可する。
    match /users/{uid}/submits/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(
                        ["v","classId","className","taskId","title","date",
                         "count","marks","createdAt","updatedAt"])
                   && (!("marks" in request.resource.data)
                        || request.resource.data.marks is map);
    }

    // 上記以外のパスはすべて拒否（デフォルト拒否）。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
